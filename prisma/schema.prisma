generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// WORKFLOW.md §1 / §4 login roles.
enum Role {
  JUNIOR
  SENIOR
  MANAGER
  PARTNER
  ADMIN
  AUDIT_ADMIN_ASSISTANT
  AUDIT_ADMIN_MANAGER
  SECRETARIAL
  SECRETARIAL_ASSISTANT
  MASTER_ADMIN
}

model Staff {
  id        String   @id @default(cuid())
  staffId   String   @unique
  name      String
  email     String   @unique
  role      Role
  // Leavers are deactivated, never deleted (RULES.md 5, audit trail).
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
