generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// WORKFLOW.md §1 / §4 login roles.
enum Role {
  JUNIOR
  SENIOR
  MANAGER
  PARTNER
  ADMIN
  AUDIT_ADMIN_ASSISTANT
  AUDIT_ADMIN_MANAGER
  SECRETARIAL
  SECRETARIAL_ASSISTANT
  MASTER_ADMIN
}

model Staff {
  id           String   @id @default(cuid())
  staffId      String   @unique
  name         String
  email        String   @unique
  role         Role
  passwordHash String
  // Leavers are deactivated, never deleted (RULES.md 5, audit trail).
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditEntries          AuditLog[]
  ownedClients          Client[]               @relation("ClientOwner")
  managedClients        Client[]               @relation("ClientManager")
  partneredClients      Client[]               @relation("ClientPartner")
  signingPartnerClients ClientSigningPartner[]
  seniorClients         Client[]               @relation("ClientSenior")
  assignedClients       ClientAssignedStaff[]
  createdAuditJobs      AuditJob[]
  confirmedDeadlines    AuditJob[]             @relation("PreAuditDeadlineConfirmedBy")
  auditStageChanges     AuditStageChange[]
  timesheetEntries      TimesheetEntry[]
  jobCheckIns           JobCheckIn[]
  notifications         Notification[]
}

// WORKFLOW.md §9: who, when, what, from, to. Append-only — the database
// rejects UPDATE, DELETE and TRUNCATE (see the add_audit_log migration).
model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorId    String?
  actor      Staff?   @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String?
  entityId   String?
  // { field: { from, to } } for updates; { field: value } snapshot for creates.
  changes    Json?
  detail     String?

  @@index([at])
  @@index([actorId, at])
  @@index([entityType, entityId, at])
  @@index([action, at])
}

// WORKFLOW.md §2 entity types.
enum EntityType {
  SDN_BHD
  PLT
  ENTERPRISE
  PARTNERSHIP
  INDIVIDUAL
}

enum Service {
  AUDIT
  TAX
  BOOKKEEPING
  SECRETARIAL
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
  NOT_INVOICED
}

enum AuditBy {
  INTERNAL
  EXTERNAL
}

// WORKFLOW.md §5 client fields.
model Client {
  id                String        @id @default(cuid())
  name              String
  entityType        EntityType
  regNo             String?       @unique
  tin               String?       @unique
  fyeDay            Int
  fyeMonth          Int
  incorporationDate DateTime?     @db.Date
  // "Sourced by" — a Manager or Partner, locked after intake.
  ownerId           String
  owner             Staff         @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  managerId         String?
  manager           Staff?        @relation("ClientManager", fields: [managerId], references: [id], onDelete: Restrict)
  partnerId         String?
  partner           Staff?        @relation("ClientPartner", fields: [partnerId], references: [id], onDelete: Restrict)
  seniorId          String?
  senior            Staff?        @relation("ClientSenior", fields: [seniorId], references: [id], onDelete: Restrict)
  services          Service[]
  dormant           Boolean       @default(false)
  status            ClientStatus  @default(ACTIVE)
  prepareFormEA     Boolean       @default(false)
  paymentStatus     PaymentStatus @default(NOT_INVOICED)
  auditBy           AuditBy?
  contactName       String?
  contactPhone      String?
  contactEmail      String?
  address           String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  signingPartners  ClientSigningPartner[]
  assignedStaff    ClientAssignedStaff[]
  externalAuditors ExternalAuditor[]
  auditJobs        AuditJob[]
  notifications    Notification[]

  @@index([name])
  @@index([managerId])
  @@index([partnerId])
  @@index([ownerId])
  @@index([seniorId])
}

// Partners (staff with login) who sign the client's audit report.
model ClientSigningPartner {
  clientId  String
  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  partnerId String
  partner   Staff  @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@id([clientId, partnerId])
}

// Juniors and Seniors assigned to (or assisting on) the client's work.
model ClientAssignedStaff {
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staffId  String
  staff    Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@id([clientId, staffId])
  @@index([staffId])
}

// Outside audit firms — recorded only, they never log in.
model ExternalAuditor {
  id            String    @id @default(cuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firmName      String
  contact       String?
  auditDeadline DateTime? @db.Date
  status        String?
  createdAt     DateTime  @default(now())

  @@index([clientId])
}

// WORKFLOW.md §3 audit track (Sdn Bhd only), in order.
enum AuditStage {
  DOCUMENTS_RECEIVED
  PRE_AUDIT
  READY
  IN_PROGRESS
  MANAGER_REVIEW
  PARTNER_REVIEW
  CLEAR_REVIEW
  FINAL_REVIEW
  FINALISATION
}

// One audit per client per financial year (the year the FYE falls in).
model AuditJob {
  id                            String      @id @default(cuid())
  clientId                      String
  client                        Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  year                          Int
  // Null until documents are received.
  stage                         AuditStage?
  createdById                   String
  createdBy                     Staff       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  // WORKFLOW.md §3: the Partner confirms the pre-audit deadline.
  preAuditDeadline              DateTime?   @db.Date
  preAuditDeadlineConfirmedById String?
  preAuditDeadlineConfirmedBy   Staff?      @relation("PreAuditDeadlineConfirmedBy", fields: [preAuditDeadlineConfirmedById], references: [id], onDelete: Restrict)
  preAuditDeadlineConfirmedAt   DateTime?
  createdAt                     DateTime    @default(now())
  updatedAt                     DateTime    @updatedAt

  stageChanges     AuditStageChange[]
  timesheetEntries TimesheetEntry[]
  checkIns         JobCheckIn[]
  notifications    Notification[]

  @@unique([clientId, year])
  @@index([stage])
  @@index([preAuditDeadline])
}

// WORKFLOW.md §7 stage change gate: note + hours + next action (+ review note at 5, 6).
model AuditStageChange {
  id           String      @id @default(cuid())
  jobId        String
  job          AuditJob    @relation(fields: [jobId], references: [id], onDelete: Restrict)
  fromStage    AuditStage?
  toStage      AuditStage
  byId         String
  by           Staff       @relation(fields: [byId], references: [id], onDelete: Restrict)
  at           DateTime    @default(now())
  progressNote String
  hours        Decimal     @db.Decimal(6, 2)
  nextAction   String
  reviewNote   String?

  @@index([jobId, at])
}

// WORKFLOW.md §10 timesheet categories. Training/CPD is information only.
enum TimesheetCategory {
  WORK
  OT
  TRAINING_CPD
}

// WORKFLOW.md §10: daily time logged by staff. Separate from stage-gate hours.
model TimesheetEntry {
  id        String            @id @default(cuid())
  staffId   String
  staff     Staff             @relation(fields: [staffId], references: [id], onDelete: Restrict)
  // Required for Work and OT; null for Training/CPD.
  jobId     String?
  job       AuditJob?         @relation(fields: [jobId], references: [id], onDelete: Restrict)
  date      DateTime          @db.Date
  hours     Decimal           @db.Decimal(4, 2)
  category  TimesheetCategory
  note      String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([staffId, date])
  @@index([jobId])
}

// WORKFLOW.md §8: "I'm working on this today" — one per person per job per day (MYT).
model JobCheckIn {
  id        String   @id @default(cuid())
  jobId     String
  job       AuditJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Restrict)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([jobId, staffId, date])
  @@index([jobId, createdAt])
}

// WORKFLOW.md §12. The tab (Action Required / FYI) follows from the kind.
enum NotificationKind {
  YOUR_TURN
  NO_UPDATE_MANAGER
  NO_UPDATE_PARTNER
  STAGE_CHANGED
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  recipient   Staff            @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  clientId    String
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  jobId       String?
  job         AuditJob?        @relation(fields: [jobId], references: [id], onDelete: Restrict)
  kind        NotificationKind
  message     String
  createdAt   DateTime         @default(now())
  // Action Required: set when the work is done. FYI: set when read.
  closedAt    DateTime?

  @@index([recipientId, closedAt])
  @@index([jobId, kind, closedAt])
}
