# Copy to .env.local and fill in real values. Never commit real values.

# PostgreSQL connection string (Neon)
DATABASE_URL=

# Session signing secret, e.g. output of: openssl rand -base64 32
NEXTAUTH_SECRET=

# App base URL, e.g. http://localhost:3000
NEXTAUTH_URL=

# Resend email API key
RESEND_API_KEY=

# Shared secret for scheduled jobs (/api/cron/*), e.g. output of: openssl rand -base64 32
CRON_SECRET=
